[
  {
    "id": "pack-de-ai-hype",
    "label": "KI hat X getötet",
    "pattern": "(chatgpt|claude|gemini|copilot|openai)\\b.{0,40}\\b(zerstört|tötet|ersetzt|ist tot|am ende)",
    "action": "Block",
    "scope": "Headline",
    "match": "Regex",
    "enabled": true
  },
  {
    "id": "pack-de-declared-dead",
    "label": "X ist tot",
    "pattern": "\\b(java|python|seo|e-?mail|passw[öo]rter|passwort|das web|das internet|blogging|google suche|google) ((ist|sind) tot|((ist|sind) )?am ende)\\b",
    "action": "Block",
    "scope": "Headline",
    "match": "Regex",
    "enabled": true
  },
  {
    "id": "pack-de-listicle",
    "label": "Listen-Artikel (Listicles)",
    "pattern": "^\\d+ (dinge|gründe|wege|zeichen|anzeichen|fakten|tricks|gewohnheiten|lebensmittel|tipps|fehler)\\b",
    "action": "Block",
    "scope": "Headline",
    "match": "Regex",
    "enabled": true
  },
  {
    "id": "pack-de-experts-say",
    "label": "Experten sagen",
    "pattern": "\\b(experten|wissenschaftler|ärzte|forscher|ernährungsberater)\\b.{0,30}\\b(sagen|enthüllen|warnen|einig|geschockt|sprachlos|verblüfft)\\b",
    "action": "Block",
    "scope": "Headline",
    "match": "Regex",
    "enabled": true
  },
  {
    "id": "pack-de-curiosity-gap",
