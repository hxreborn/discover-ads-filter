    "action": "Block",
    "scope": "Headline",
    "match": "Regex",
    "enabled": true
  },
  {
    "id": "pack-de-farewell",
    "label": "Abschied von X",
    "pattern": "^(auf wiedersehen|abschied von|sag(t)? tschüss)\\b",
    "action": "Block",
    "scope": "Headline",
    "match": "Regex",
    "enabled": true
  },
  {
    "id": "pack-de-official-claim",
    "label": "Offiziell bestätigt",
    "pattern": "\\b(es ist offiziell|offiziell bestätigt|von der (eu|regierung) bestätigt)\\b",
    "action": "Block",
    "scope": "Headline",
    "match": "Regex",
    "enabled": true
  },
  {
    "id": "pack-de-secret-trick",
    "label": "Geheimer Trick",
    "pattern": "\\b(geheime[nrs]?|versteckte[nrs]?) (funktion|feature|trick|einstellung|grund|menü)\\b",
    "action": "Block",
    "scope": "Headline",
    "match": "Regex",
    "enabled": true
  },
  {
    "id": "pack-de-doing-it-wrong",
    "label": "Immer falsch gemacht",
    "pattern": "\\b(hast du|haben sie).{0,25}(immer )?falsch gemacht\\b",
    "action": "Block",
    "scope": "Headline",
    "match": "Regex",
    "enabled": true
  },
  {
    "id": "pack-de-urgent-prefix",
    "label": "Dringlichkeits-Präfixe",
    "pattern": "^(warnung|achtung|eilmeldung|dringend|alarm)[:!]",
    "action": "Block",
    "scope": "Headline",
    "match": "Regex",
    "enabled": true
  },
  {
    "id": "pack-de-money-bait",
    "label": "Geld im Titel",
    "pattern": "([€] ?\\d{2,}|\\b\\d{2,} ?€|\\b(\\d{2,}|tausende) (euro|dollar)\\b)",
    "action": "Block",
    "scope": "Headline",
    "match": "Regex",
    "enabled": true
  },
  {
    "id": "pack-de-tabloid",
    "label": "Boulevard-Drama",
    "pattern": "\\b(bricht (sein|ihr) schweigen|packt aus|rechnet ab|sorgt für (wirbel|aufsehen)|fans sind sich sicher)\\b",
    "action": "Block",
    "scope": "Headline",
    "match": "Regex",
    "enabled": true
  },
  {
    "id": "pack-de-viral-bait",
    "label": "Geht viral",
    "pattern": "\\b(geht viral|bricht das internet|macht sprachlos|das netz lacht|rasten aus|drehen durch)\\b",
    "action": "Block",
    "scope": "Headline",
    "match": "Regex",
    "enabled": true
  },
  {
